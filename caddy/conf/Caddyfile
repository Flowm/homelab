{
	admin off

	log access_stdout {
		output stdout
		include http.log.access
	}
}

(default) {
	log {
		output file /var/log/caddy/access.log
	}

	encode zstd gzip
	header {
		-Server
	}
}

home.spirit.frcy.org spirit.frcy.org {
	import default
	tls internal

	handle_path /jellyfin/* {
		reverse_proxy http://192.168.144.6:8096 {
		}
	}

	handle /dozzle/* {
		reverse_proxy http://dozzle:8080 {
			@event_stream header Content-Type text/event-stream*
			handle_response @event_stream {
				header Cache-Control "no-cache, no-transform"
				copy_response_headers {
					exclude Cache-Control
				}
				copy_response
			}

			flush_interval -1
		}
	}
}

admin.spirit.frcy.org {
	import default
	tls internal

	reverse_proxy https://192.168.144.6:1443 {
		transport http {
			tls
			tls_insecure_skip_verify
		}
	}
}
