{
	admin off

	log access_stdout {
		output stdout
		include http.log.access
	}
}

(default) {
	log {
		output file /var/log/caddy/access.log
	}

	@encoded not path /dozzle/api/events/stream*
	encode @encoded zstd gzip
	header {
		-Server
	}
}

home.spirit.frcy.org spirit.frcy.org {
	import default
	tls internal

	handle_path /jellyfin/* {
		reverse_proxy http://192.168.144.6:8096 {
		}
	}

	handle /teslamate/grafana/* {
		reverse_proxy http://grafana:3000
	}

	handle /teslamate/* {
		reverse_proxy http://teslamate:4000
	}

	redir /atuin /atuin/
	handle /atuin/* {
		reverse_proxy http://atuin:8888
	}

	handle /dozzle/* {
		reverse_proxy http://dozzle:8080 {
			flush_interval -1
		}
	}
}

admin.spirit.frcy.org {
	import default
	tls internal

	reverse_proxy https://192.168.144.6:1443 {
		transport http {
			tls
			tls_insecure_skip_verify
		}
	}
}
